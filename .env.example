# Copy to .env and fill in. .env is gitignored.

# Required: LLM analysis, Q&A and voice transcription (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the Groq models
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional: MiniLM embeddings + cross-encoder re-ranker.
# On by default on Linux/cloud; off by default on macOS (PyTorch thread deadlocks). Set 1 to enable.
# CLAUSEWISE_NEURAL=1

# Optional: LLM tracing with Langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
